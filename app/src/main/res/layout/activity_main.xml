<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAF0"
    android:orientation="vertical">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/tab_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/tab_slot_1" style="@style/SlotTab" android:text="Muse" />
            <TextView android:id="@+id/tab_slot_2" style="@style/SlotTab" android:text="Slot 2" />
            <TextView android:id="@+id/tab_slot_3" style="@style/SlotTab" android:text="Slot 3" />
            <TextView android:id="@+id/tab_slot_4" style="@style/SlotTab" android:text="Slot 4" />
            <TextView android:id="@+id/tab_slot_5" style="@style/SlotTab" android:text="Slot 5" />
            <TextView android:id="@+id/tab_group" style="@style/SlotTab" android:text="Group" />
        </LinearLayout>
    </HorizontalScrollView>
    <FrameLayout
        android:id="@+id/slot_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/group_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />
</LinearLayout>
